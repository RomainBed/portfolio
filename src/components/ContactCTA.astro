---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside id="contact">
	<div class="contact-inner">
		<div class="copy">
			<h2>Échangeons</h2>
			<p>Une opportunité, un projet ou simplement envie d’échanger autour du développement ?</p>
		</div>
		<div class="actions">
			<CallToAction href="mailto:romainbedouret@gmail.com">
				Me contacter
				<Icon icon="paper-plane-tilt" size="1.2em" />
			</CallToAction>
			<CallToAction href="https://www.linkedin.com/in/romain-bedouret-1454941b4/" variant="secondary" external>
				LinkedIn
				<Icon icon="linkedin-logo" size="1.2em" />
			</CallToAction>
		</div>
	</div>
</aside>

<style>
	aside {
		border-top: 1px solid var(--gray-800);
		padding: 4rem 1.5rem;
	}

	.contact-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding: 2.5rem 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.copy {
		display: grid;
		gap: 0.75rem;
		text-align: center;
	}

	h2 {
		font-size: var(--text-xl);
	}

	p { max-width: 54ch; color: var(--gray-300); }

	.actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		width: min(100%, 24rem);
	}

	.actions > :global(a) { width: 100%; }

	@media (min-width: 50em) {
		.contact-inner {
			padding: 3.5rem 4rem;
			gap: 2.25rem;
		}

		h2 {
			font-size: var(--text-3xl);
		}

		.copy { text-align: center; }
	}

	@media (max-width: 28em) {
		.actions { grid-template-columns: 1fr; width: min(100%, 16rem); }
	}
</style>
