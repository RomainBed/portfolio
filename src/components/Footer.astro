---
---

<footer>
	<div class="footer-inner">
		<div class="identity">
			<strong>Romain Bedouret</strong>
			<span>Développeur Full Stack PHP / Symfony</span>
		</div>
		<div class="meta">
			<p>&copy; <span id="year"></span></p>
			<a href="https://www.linkedin.com/in/romain-bedouret-1454941b4/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</div>
</footer>

<script>
  const yearEl = document.getElementById("year");
  if (yearEl) {
    yearEl.textContent = String(new Date().getFullYear());
  }
</script>

<style>
	footer {
		margin-top: auto;
		padding: 0 1.5rem 3rem;
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding-top: 2rem;
		border-top: 1px solid var(--gray-800);
		text-align: center;
	}

	footer a {
		color: var(--gray-400);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		text-decoration-color: currentColor;
	}

	.identity {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.identity strong { color: var(--gray-200); font-family: var(--font-brand); }

	.meta {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	@media (min-width: 50em) {
		.footer-inner {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}
	}
</style>
