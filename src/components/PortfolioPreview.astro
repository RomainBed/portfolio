---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
const showPreviewImage = Boolean(data.img && data.order !== 4);
---

<a class="card" href={`/portfolio/work/${id}`}>
	<div class:list={['visual', `visual-${data.order}`]} aria-hidden={!showPreviewImage ? 'true' : undefined}>
		<span class="visual-index" aria-hidden="true">0{data.order}</span>
		{showPreviewImage ? (
			<img src={data.img!} alt={data.img_alt || ''} loading="lazy" decoding="async" />
		) : (
			<span class="visual-mark">{data.order === 1 ? 'POSE' : data.order === 2 ? 'MC' : data.order === 3 ? 'AU' : 'HD'}</span>
		)}
	</div>
	<div class="body">
		<p class="eyebrow">{data.subtitle}</p>
		<h3>{data.title}</h3>
		<p class="description">{data.description}</p>
		<ul class="tags" aria-label="Technologies principales">
			{data.tags.slice(0, 5).map((tag) => <li>{tag}</li>)}
		</ul>
		<span class="project-link">Voir la fiche <span aria-hidden="true">→</span></span>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: var(--gray-200);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition), border-color var(--theme-transition);
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-0.25rem);
		box-shadow: var(--shadow-md);
		border-color: var(--accent-regular);
	}

	.visual {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 7.5rem;
		padding: 1.5rem;
		overflow: hidden;
		background: linear-gradient(135deg, #1c0056, #7611a6 55%, #c561f6);
	}

	.visual::after {
		content: '';
		position: absolute;
		width: 8rem;
		height: 8rem;
		right: -2.5rem;
		top: -3.5rem;
		border: 1px solid rgb(255 255 255 / 0.35);
		border-radius: 50%;
	}

	.visual-2 { background: linear-gradient(135deg, #15345c, #2463a5 55%, #64b5cf); }
	.visual-3 { background: linear-gradient(135deg, #0c4639, #128768 55%, #71d6a7); }
	.visual-4 { background: linear-gradient(135deg, #49351f, #94622d 55%, #d79a4b); }

	.visual-mark {
		font-family: var(--font-brand);
		font-size: var(--text-2xl);
		color: white;
		letter-spacing: 0.04em;
	}

	.visual-index {
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 2;
		padding: 0.25rem 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.4);
		border-radius: 999rem;
		color: white;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.visual img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.8rem;
		padding: 1.5rem;
	}

	.eyebrow {
		color: var(--accent-dark);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	h3 { font-size: var(--text-lg); }

	.description { max-width: 62ch; color: var(--gray-300); line-height: 1.55; }

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--gray-700);
		border-radius: 999rem;
		color: var(--gray-300);
		font-size: 0.78rem;
	}

	.project-link {
		margin-top: auto;
		padding-top: 0.5rem;
		color: var(--link-color);
		font-weight: 700;
	}

	@media (min-width: 50em) {
		.visual { min-height: 9rem; }
		.body { padding: 1.75rem; }
	}
</style>
