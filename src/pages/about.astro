---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';

const experiences = [
	{
		company: 'SERMA ENERGY',
		period: 'Juin 2024 à aujourd’hui',
		role: 'Développeur Full Stack PHP / Symfony',
		description: 'Développement et évolution d’une application métier utilisée quotidiennement par plusieurs équipes. Migration PHP vers Symfony, automatisation de traitements, dashboards et développement de fonctionnalités métier.',
	},
	{
		company: 'Auromate',
		period: 'Mars 2025 à aujourd’hui',
		role: 'Développeur Web & Automatisation — Micro-entreprise, activité parallèle',
		description: 'Développement web et expérimentation de solutions d’automatisation avec n8n pour simplifier des processus métier.',
	},
	{
		company: 'Ynov Campus',
		period: '2025 / 2026',
		role: 'Jury évaluateur',
		description: 'Participation aux jurys de la certification RNCP Expert en développement logiciel : évaluation des dossiers techniques et soutenances des candidats.',
	},
	{
		company: 'Dimotrans / HDucros',
		period: 'Septembre 2022 à avril 2024',
		role: 'Développeur Web',
		description: 'Développement d’applications et outils internes avec PHP, Symfony, JavaScript et Python.',
	},
	{
		company: 'Intermarché',
		period: '2019 à 2022',
		role: 'Employé libre-service — CDI',
		description: 'CDI occupé en parallèle de ma formation, au sein de l’équipe du magasin d’Aigrefeuille-d’Aunis.',
	},
	{
		company: 'Omnium Finance',
		period: 'Mai à juillet 2021',
		role: 'Développeur logiciel — Stage',
		description: 'Planification des tâches, développement d’indicateurs dans le logiciel GPLI, maintenance des postes de travail et contrôles réseau.',
	},
];

const skills = [
	{ title: 'Back-end', items: ['PHP', 'Symfony', 'Doctrine ORM'] },
	{ title: 'Front-end', items: ['JavaScript', 'HTML/CSS', 'Bootstrap', 'React'] },
	{ title: 'Bases de données', items: ['PostgreSQL', 'MySQL', 'SQL'] },
	{ title: 'Outils & environnement', items: ['Git', 'Docker', 'Linux'] },
	{ title: 'Automatisation', items: ['n8n', 'Python', 'VBA'] },
	{ title: 'Autres expériences', items: ['Next.js', 'TypeScript', 'Node.js', 'Tailwind CSS'] },
];
---

<BaseLayout
	title="Parcours — Romain Bedouret, Développeur Full Stack PHP / Symfony"
	description="Parcours, expériences et compétences de Romain Bedouret, développeur Full Stack spécialisé PHP/Symfony à Bordeaux."
>
	<div class="stack gap-20">
		<main class="wrapper about stack gap-15">
			<Hero title="Parcours" tagline="Développeur Full Stack PHP / Symfony, je travaille depuis 2022 sur des applications web et outils métier. Mon parcours associe développement d’applications internes, conception full stack et automatisation de processus." />

			<section aria-labelledby="experience-title">
				<header class="section-heading">
					<p>Expérience</p>
					<h2 id="experience-title">Mon parcours professionnel</h2>
				</header>
				<ol class="timeline">
					{experiences.map((experience) => (
						<li>
							<div class="timeline-marker" aria-hidden="true"></div>
							<article>
								<div class="experience-head">
									<h3>{experience.company}</h3>
									<time>{experience.period}</time>
								</div>
								{'location' in experience && <p class="location">{experience.location}</p>}
								<p class="role">{experience.role}</p>
								<p>{experience.description}</p>
							</article>
						</li>
					))}
				</ol>
			</section>

			<section aria-labelledby="formation-title">
				<header class="section-heading">
					<p>Formation</p>
					<h2 id="formation-title">Diplômes</h2>
				</header>
				<div class="education-grid">
					<article><p class="year">2023</p><h3>Licence Professionnelle DAWIN</h3><p>Développement Web<br />Université de Bordeaux</p></article>
					<article><p class="year">2022</p><h3>BTS SNIR</h3><p>Développement & Réseaux<br />Lycée Léonce Vieljeux</p></article>
					<article><p class="year">2019</p><h3>Baccalauréat scientifique</h3><p>Lycée Maurice Merleau-Ponty<br />Rochefort</p></article>
				</div>
			</section>

			<section aria-labelledby="skills-title">
				<header class="section-heading">
					<p>Compétences</p>
					<h2 id="skills-title">Technologies & outils</h2>
				</header>
				<div class="skills-grid">
					{skills.map((category) => (
						<article>
							<h3>{category.title}</h3>
							<ul>{category.items.map((item) => <li>{item}</li>)}</ul>
						</article>
					))}
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about { max-width: 72rem; }
	section { display: grid; gap: 2rem; }
	.section-heading > p { margin-bottom: 0.5rem; color: var(--accent-dark); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	.section-heading h2 { font-size: var(--text-3xl); }

	.timeline { padding: 0; list-style: none; }
	.timeline > li { position: relative; display: grid; grid-template-columns: 1rem 1fr; gap: 1rem; }
	.timeline > li:not(:last-child)::before { content: ''; position: absolute; left: 0.34rem; top: 1.35rem; bottom: 0; width: 1px; background: var(--gray-700); }
	.timeline-marker { width: 0.75rem; height: 0.75rem; margin-top: 1.65rem; border: 2px solid var(--accent-regular); border-radius: 50%; background: var(--gray-999); z-index: 1; }
	.timeline article { padding: 1.25rem 0 1.35rem; border-bottom: 1px solid var(--gray-800); }
	.timeline > li:last-child article { border-bottom: 0; }
	.education-grid article, .skills-grid article { padding: 1.5rem; border: 1px solid var(--gray-800); border-radius: 1rem; background: var(--gray-999_40); box-shadow: var(--shadow-sm); }
	.experience-head { display: flex; flex-direction: column; gap: 0.3rem; }
	.experience-head h3, .education-grid h3, .skills-grid h3 { font-size: var(--text-xl); }
	time, .year { color: var(--accent-dark); font-size: var(--text-sm); font-weight: 700; }
	.location { margin-top: 0.25rem; color: var(--gray-400); font-size: var(--text-sm); }
	.role { margin: 0.35rem 0 0.55rem; color: var(--gray-100); font-weight: 700; }
	.timeline article > p:last-child, .education-grid article > p:last-child { color: var(--gray-300); }

	.education-grid, .skills-grid { display: grid; gap: 1rem; }
	.education-grid article { display: grid; gap: 0.6rem; }
	.skills-grid article { display: flex; flex-direction: column; gap: 1rem; }
	.skills-grid ul { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; list-style: none; }
	.skills-grid li { padding: 0.4rem 0.7rem; border: 1px solid var(--gray-700); border-radius: 999rem; color: var(--gray-300); font-size: var(--text-sm); }

	@media (min-width: 50em) {
		section { grid-template-columns: minmax(12rem, 1fr) minmax(0, 2.2fr); gap: 4rem; }
		.section-heading h2 { font-size: var(--text-3xl); }
		.experience-head { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 2rem; }
		.education-grid { grid-template-columns: repeat(3, 1fr); }
		.skills-grid { grid-template-columns: 1fr 1fr; }
	}
</style>
