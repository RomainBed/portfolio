---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';

const projectIds = [
	'pose',
	'memoire-de-classe',
	'auromate',
	'applications-metier-hducros-dimotrans',
] as const;
const allProjects = await getCollection('work');
const projects = projectIds.map((projectId) => {
	const project = allProjects.find((entry) => entry.id === projectId);
	if (!project) throw new Error(`Projet obligatoire introuvable : ${projectId}`);
	return project;
});
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-15 lg:gap-20">
			<header class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Romain Bedouret</p>
					<h1>Développeur Full Stack <span>PHP / Symfony</span></h1>
					<p class="tagline">Je conçois et fais évoluer des applications web métier, de l’analyse du besoin jusqu’au déploiement.</p>
					<p class="stack-line" aria-label="Technologies principales">PHP <span>·</span> Symfony <span>·</span> JavaScript <span>·</span> PostgreSQL <span>·</span> Docker <span>·</span> n8n</p>
					<div class="hero-actions">
						<a class="hero-link primary" href="/portfolio/work/">Découvrir mes projets <Icon icon="arrow-right" size="1.1em" /></a>
						<a class="hero-link secondary" href="/portfolio/about/">Voir mon parcours</a>
						<a class="linkedin" href="https://www.linkedin.com/in/romain-bedouret-1454941b4/" target="_blank" rel="noopener noreferrer">
							<Icon icon="linkedin-logo" /> LinkedIn <span class="sr-only">(nouvel onglet)</span>
						</a>
					</div>
				</div>

				<img alt="Portrait de Romain Bedouret" width="480" height="620" src="/portfolio/assets/portrait.png" />
			</header>

			<Skills />
		</div>

		<main class="wrapper">
			<section class="projects stack gap-10">
				<header class="section-header">
					<div>
						<p class="eyebrow">Sélection</p>
						<h2>Projets mis en avant</h2>
					</div>
				</header>
				<Grid>
					{projects.map((project) => <li><PortfolioPreview project={project} /></li>)}
				</Grid>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero { display: flex; flex-direction: column-reverse; align-items: center; gap: 2.5rem; }
	.hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
	.eyebrow { color: var(--accent-dark); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	h1 { max-width: 14ch; font-size: clamp(2.6rem, 8vw, 4.75rem); }
	h1 span { color: var(--accent-regular); }
	.tagline { max-width: 52ch; color: var(--gray-300); font-size: var(--text-lg); }
	.stack-line { display: flex; flex-wrap: wrap; gap: 0.45rem; color: var(--gray-400); font-size: var(--text-sm); font-weight: 700; }
	.stack-line span { color: var(--accent-regular); }
	.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 0.35rem; }
	.hero-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 2.75rem;
		padding: 0.7rem 1.15rem;
		border-radius: 999rem;
		font-weight: 700;
		line-height: 1.1;
		text-decoration: none;
		transition: transform var(--theme-transition), border-color var(--theme-transition), box-shadow var(--theme-transition);
	}
	.hero-link:hover { transform: translateY(-0.12rem); }
	.hero-link.primary { color: var(--accent-text-over); background: var(--gradient-accent-orange); box-shadow: var(--shadow-sm); }
	.hero-link.secondary { color: var(--gray-100); border: 1px solid var(--gray-700); background: var(--gray-999_40); }
	.linkedin { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0.6rem 0.4rem; color: var(--gray-300); font-size: var(--text-sm); font-weight: 700; text-underline-offset: 0.25em; }

	.hero img {
		width: min(100%, 25rem);
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: center 18%;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.projects { position: relative; }
	.projects::before {
		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		top: -6rem;
		width: 100vw;
		height: 28rem;
		transform: translateX(-50%);
		background: var(--bg-image-subtle-2) top center / var(--bg-gradient-size) no-repeat;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.section-header { display: flex; flex-direction: column; gap: 1rem; }
	.section-header h2 { margin-top: 0.4rem; font-size: var(--text-3xl); }

	@media (min-width: 50em) {
		.hero { display: grid; grid-template-columns: minmax(0, 6fr) minmax(18rem, 4fr); gap: 4rem; padding-inline: 2.5rem; }
		.hero img { aspect-ratio: 3 / 4; border-radius: 4rem; }
		.section-header { flex-direction: row; align-items: end; justify-content: space-between; }
		.section-header h2 { font-size: var(--text-4xl); }
	}

	@media (max-width: 28em) {
		.hero-link { width: 100%; }
		.linkedin { margin-inline: auto; }
	}
</style>
